# =============================================================================
# Variables d'environnement — Maison d'Actions Solidaires
# =============================================================================
# Copiez ce fichier vers .env.local puis remplacez chaque valeur.
#
#   cp .env.example .env.local
#
# ⚠️ Ne commitez JAMAIS .env.local : il contient des secrets réels.
#    Le .gitignore couvre déjà tous les fichiers .env*.
# =============================================================================

# --- Base de données PostgreSQL (Supabase) -----------------------------------
# Chaîne de connexion complète, disponible dans Supabase > Project Settings >
# Database > Connection string. Utilisez le pooler pour un déploiement
# serverless (Vercel).
# Format attendu : postgresql://<utilisateur>:<mot-de-passe>@<hote>:<port>/postgres
DATABASE_URL=

# --- Supabase Storage (upload d'images et de vidéos) -------------------------
# URL du projet : Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co

# Clé service_role : Supabase > Project Settings > API > service_role secret.
# ⚠️ Cette clé contourne toutes les policies RLS. Elle ne doit jamais être
#    exposée côté client ni préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Clé anon (publique). Non utilisée par le code actuel, conservée si vous
# ajoutez des appels Supabase directement depuis le navigateur.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# --- Authentification --------------------------------------------------------
# Secret de signature des JWT. 32 caractères minimum (le code refuse en deçà).
# Générez-en un avec :  openssl rand -hex 64
JWT_SECRET=remplacez_par_une_chaine_aleatoire_de_64_octets_minimum

# --- URL du site -------------------------------------------------------------
# Sert à construire les liens des e-mails (réinitialisation de mot de passe)
# et à valider l'origine des requêtes (protection CSRF).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Envoi d'e-mails (SMTP) --------------------------------------------------
# Formulaire de contact, réinitialisation de mot de passe, création de compte.
# Avec Gmail, utilisez un « mot de passe d'application », pas votre mot de
# passe de compte : https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@exemple.org
SMTP_PASS=mot_de_passe_application

# Adresse recevant les messages du formulaire de contact.
# Par défaut, SMTP_USER est utilisé si cette variable est absente.
CONTACT_EMAIL=adresse@exemple.org

# --- Options de développement (facultatif) -----------------------------------
# Autorise les requêtes d'écriture sans en-tête Origin/Referer (outils type
# curl ou Postman). À laisser désactivé : mettre à true affaiblit la
# protection CSRF, à ne jamais activer en production.
# CSRF_ALLOW_NO_ORIGIN=false

# Identifiants utilisés par la suite de tests pour les scénarios authentifiés.
# Laissez vides pour que ces tests soient ignorés.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
